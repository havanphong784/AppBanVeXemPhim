<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinema.controller.MainController"
            styleClass="main-container" prefWidth="900" prefHeight="600">
    <top>
        <VBox spacing="5" alignment="CENTER">
            <padding><Insets top="10" bottom="20"/></padding>
            <Label text="🎬 CINEMA BOOKING" styleClass="title-label"/>
            <Label text="Chọn phim và suất chiếu" styleClass="subtitle-label"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="movieContainer" hgap="20" vgap="20" alignment="CENTER">
                <padding><Insets topRightBottomLeft="10"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>
</BorderPane>
